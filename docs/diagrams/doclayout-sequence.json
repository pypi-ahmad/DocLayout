{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "DocLayout grounded chat verification",
    "viewBox": [820, 500],
    "animation": "none",
    "quality_profile": "showcase",
    "legend": { "mode": "hidden" },
    "views": [
      {
        "id": "context-retrieval",
        "label": "Context retrieval",
        "focus": ["user", "ui", "doc_model"],
        "note": "User question triggers retrieval of normalized page text from Document Model."
      },
      {
        "id": "draft-and-quotes",
        "label": "Draft and quotes",
        "focus": ["ui", "luna_chat", "verifier"],
        "note": "Luna generates draft answers with quotes verified against local page text."
      },
      {
        "id": "audit-and-display",
        "label": "Independent audit",
        "focus": ["ui", "luna_judge", "user"],
        "note": "Secondary Luna audit evaluates factual grounding before rendering."
      }
    ]
  },
  "participants": [
    { "id": "user", "type": "external", "label": "User", "sublabel": "browser session" },
    { "id": "ui", "type": "frontend", "label": "Streamlit", "sublabel": "chat interface" },
    { "id": "doc_model", "type": "database", "label": "Doc Model", "sublabel": "active page text" },
    { "id": "luna_chat", "type": "cloud", "label": "Luna Chat", "sublabel": "draft generation" },
    { "id": "verifier", "type": "security", "label": "Verifier", "sublabel": "exact substring" },
    { "id": "luna_judge", "type": "cloud", "label": "Luna Judge", "sublabel": "audit verifier" }
  ],
  "messages": [
    { "id": "submit-question", "from": "user", "to": "ui", "y": 160, "label": "ask question", "variant": "default" },
    { "id": "fetch-context", "from": "ui", "to": "doc_model", "y": 188, "label": "get page text", "variant": "emphasis" },
    { "id": "return-context", "from": "doc_model", "to": "ui", "y": 216, "label": "normalized text", "variant": "return" },
    { "id": "request-draft", "from": "ui", "to": "luna_chat", "y": 244, "label": "prompt + text", "variant": "emphasis" },
    { "id": "return-draft", "from": "luna_chat", "to": "ui", "y": 272, "label": "draft + citations", "variant": "return" },
    { "id": "verify-quotes", "from": "ui", "to": "verifier", "y": 300, "label": "match substrings", "variant": "security" },
    { "id": "quote-results", "from": "verifier", "to": "ui", "y": 328, "label": "matched quotes", "variant": "return" },
    { "id": "request-audit", "from": "ui", "to": "luna_judge", "y": 356, "label": "audit draft & quotes", "variant": "security" },
    { "id": "return-audit", "from": "luna_judge", "to": "ui", "y": 384, "label": "verification score", "variant": "return" },
    { "id": "render-answer", "from": "ui", "to": "user", "y": 412, "label": "grounded response", "variant": "return" }
  ],
  "activations": [
    { "participant": "ui", "from": 160, "to": 417, "type": "frontend" },
    { "participant": "doc_model", "from": 188, "to": 220, "type": "database" },
    { "participant": "luna_chat", "from": 244, "to": 276, "type": "cloud" },
    { "participant": "verifier", "from": 300, "to": 332, "type": "security" },
    { "participant": "luna_judge", "from": 356, "to": 388, "type": "cloud" }
  ]
}
