{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "DocLayout document chat verification",
    "viewBox": [
      1080,
      620
    ],
    "quality_profile": "showcase",
    "column_fit": "spread",
    "views": [
      {
        "id": "context-retrieval",
        "label": "Context retrieval",
        "focus": [
          "user",
          "ui",
          "doc_model"
        ],
        "note": "Chat uses all parsed pages in the active result, not the preview-page selection."
      },
      {
        "id": "draft-and-quotes",
        "label": "Draft and quotes",
        "focus": [
          "ui",
          "luna_chat",
          "verifier"
        ],
        "note": "Luna generates draft answers with quotes verified against local page text."
      },
      {
        "id": "audit-and-display",
        "label": "Independent audit",
        "focus": [
          "ui",
          "luna_judge",
          "user"
        ],
        "note": "A second Luna request returns approval, not a numeric confidence score."
      }
    ]
  },
  "participants": [
