    {
      "dot": "emerald",
      "title": "Local Processing Core",
      "items": [
        "Providers prepare files and rasterize pages one by one at 192 DPI",
        "Document builder orchestrates block mapping and structural processors",
        "In-memory document model holds all pages, blocks, and token usage"
      ]
    },
    {
      "dot": "cyan",
      "title": "Model Inference Boundaries",
      "items": [
        "Shared Sol client manages rate-limiting with at most 3 concurrent calls",
        "Document chat uses a dedicated Luna service with independent verification",
        "Rendering, annotation, and ZIP generation require no model calls"
      ]
    },
    {
      "dot": "violet",
      "title": "Multi-Surface Ownership",
      "items": [
        "Streamlit GUI, CLI commands, and HTTP API share the same core pipeline",
        "Session state is isolated in memory with no persistent document store",
        "Local exports produce Markdown, hierarchical JSON, chunks, and styled HTML"
      ]
    }
