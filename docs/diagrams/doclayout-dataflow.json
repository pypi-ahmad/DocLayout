{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "DocLayout data flow",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      520
    ]
  },
  "stages": [
    {
      "label": "Input"
    },
    {
      "label": "Page data"
    },
    {
      "label": "Transcription"
    },
    {
      "label": "Alignment"
    },
    {
      "label": "Outputs"
    }
  ],
  "nodes": [
    {
      "id": "source-file",
      "type": "external",
      "label": "Document",
      "sublabel": "Selected pages",
      "stage": 0,
      "row": 0
    },
    {
      "id": "page-image",
      "type": "backend",
      "label": "Page image",
      "sublabel": "192 DPI render",
      "stage": 1,
      "row": 0
    },
    {
      "id": "sol-response",
      "type": "cloud",
      "label": "GPT-6 Sol",
      "sublabel": "Transcribes HTML",
      "stage": 2,
      "row": 0
    },
    {
      "id": "aligned-content",
      "type": "security",
      "label": "Aligned blocks",
      "sublabel": "Validated Sol content",
      "stage": 3,
      "row": 0
    },
    {
      "id": "result-document",
      "type": "database",
      "label": "Document",
      "sublabel": "Protected source blocks",
      "stage": 4,
      "row": 0
    },
    {
      "id": "v3-regions",
      "type": "backend",
      "label": "V3 regions",
      "sublabel": "Pixel boxes and order",
      "stage": 1,
      "row": 2
    },
    {
      "id": "layout-diagnostics",
      "type": "database",
      "label": "Diagnostics",
      "sublabel": "Matches and fallback",
      "stage": 3,
      "row": 2
    },
    {
      "id": "export-files",
      "type": "backend",
      "label": "Local exports",
      "sublabel": "Text, JSON, annotations",
      "stage": 4,
      "row": 2
    }
  ],
  "flows": [
    {
      "id": "source-file-to-page-image",
      "from": "source-file",
      "to": "page-image",
      "label": "render"
    },
    {
      "id": "page-image-to-sol-response",
      "from": "page-image",
      "to": "sol-response",
      "label": "full image"
    },
    {
      "id": "page-image-to-v3-regions",
      "from": "page-image",
      "to": "v3-regions",
      "label": "analyze"
    },
    {
      "id": "v3-regions-to-sol-response",
      "from": "v3-regions",
      "to": "sol-response",
      "fromSide": "right",
      "toSide": "bottom",
      "via": [[530, 385]],
      "label": "guide if ready"
    },
    {
      "id": "sol-response-to-aligned-content",
      "from": "sol-response",
      "to": "aligned-content",
      "label": "HTML + boxes"
    },
    {
      "id": "aligned-content-to-result-document",
      "from": "aligned-content",
      "to": "result-document",
      "label": "build"
    },
    {
      "id": "aligned-content-to-layout-diagnostics",
      "from": "aligned-content",
      "to": "layout-diagnostics",
      "label": "record"
    },
    {
      "id": "result-document-to-export-files",
      "from": "result-document",
      "to": "export-files",
      "label": "render"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Geometry and order",
      "items": [
        "V3 returns rectangles; four corners are derived for PolygonBox.",
        "An evaluated policy applies confident one-to-one matches before grouping."
      ]
    },
    {
      "dot": "emerald",
      "title": "Fallback and reuse",
      "items": [
        "Missing or incompatible regions retain Sol content and geometry.",
        "V3 runtime failure omits the guide; all exports reuse the resulting document."
      ]
    }
  ]
}
