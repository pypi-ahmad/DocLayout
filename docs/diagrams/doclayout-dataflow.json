{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "DocLayout data flow",
    "quality_profile": "showcase",
    "legend": { "entries": { "dashed": { "label": "refinement" }, "security": { "label": "verification" } } },
    "viewBox": [1080, 620],
    "views": [
      {
        "id": "extraction-pipeline",
        "label": "Extraction pipeline",
        "focus": ["inputs", "provider", "sol_extract", "validator", "processors", "doc_model"],
        "note": "Rendered pages get a V3 prior when available. Sol supplies content; rejected matches or failed layout retain Sol geometry."
      },
      {
        "id": "rendering-exports",
        "label": "Local exports",
        "focus": ["doc_model", "renderers", "gui_export"],
        "note": "Local rendering produces Markdown, JSON chunks, styled HTML, annotated images, and raster PDFs without model calls."
      },
      {
        "id": "grounded-chat",
        "label": "Grounded chat",
        "focus": ["doc_model", "page_text", "luna_draft", "quote_verify"],
        "note": "Luna generates answers with page quotes, independently verified against parsed page text before citation."
      }
    ]
  },
  "stages": [
    { "label": "Ingest" },
    { "label": "Extract" },
    { "label": "Process" },
    { "label": "Model" },
    { "label": "Deliver & Verify" }
  ],
  "nodes": [
    {
      "id": "inputs",
      "type": "external",
      "label": "Source Documents",
      "sublabel": "PDF, Office, image",
      "stage": 0,
      "row": 1,
      "tag": "multi-format"
    },
    {
      "id": "provider",
      "type": "backend",
      "label": "Render + V3",
      "sublabel": "page image + prior",
      "stage": 0,
      "row": 2,
      "tag": "192 DPI"
    },
    {
      "id": "sol_extract",
      "type": "cloud",
      "label": "GPT-6 Sol",
      "sublabel": "page extraction",
      "stage": 1,
      "row": 1,
      "tag": "3 concurrent max"
    },
    {
      "id": "validator",
      "type": "security",
      "label": "Block Validator",
      "sublabel": "sanitize + match V3",
      "stage": 1,
      "row": 2,
      "tag": "Pydantic"
    },
    {
      "id": "processors",
      "type": "backend",
      "label": "Processors",
      "sublabel": "document structure",
      "stage": 2,
      "row": 1
    },
    {
      "id": "sol_refine",
      "type": "cloud",
      "label": "Sol Refinement",
      "sublabel": "optional cleanup",
      "stage": 2,
      "row": 2,
      "tag": "fallback safe"
    },
    {
      "id": "doc_model",
      "type": "database",
      "label": "Document Model",
      "sublabel": "blocks & reading order",
      "stage": 3,
      "row": 1,
      "tag": "in-memory"
    },
    {
      "id": "page_text",
      "type": "database",
      "label": "Parsed Page Text",
      "sublabel": "normalized quotes",
      "stage": 3,
      "row": 3,
      "yOffset": -15
    },
    {
      "id": "renderers",
      "type": "backend",
      "label": "Local Renderers",
      "sublabel": "Markdown & chunks",
      "stage": 4,
      "row": 0
    },
    {
      "id": "gui_export",
      "type": "frontend",
      "label": "GUI & File Exports",
      "sublabel": "HTML, PDF & ZIP",
      "stage": 4,
      "row": 1
    },
    {
      "id": "luna_draft",
      "type": "cloud",
      "label": "GPT-6 Luna",
      "sublabel": "grounded draft",
      "stage": 4,
      "row": 2
    },
    {
      "id": "quote_verify",
      "type": "security",
      "label": "Luna Verification",
      "sublabel": "quote validation",
      "stage": 4,
      "row": 3,
      "yOffset": -15,
      "tag": "cited answers"
    }
  ],
  "flows": [
    {
      "id": "doc-bytes",
      "from": "inputs",
      "to": "provider",
      "label": "document bytes",
      "classification": "raw files"
    },
    {
      "id": "rendered-pages",
      "from": "provider",
      "to": "sol_extract",
      "label": "image + prior",
      "classification": "image only if V3 fails",
      "variant": "emphasis"
    },
    {
      "id": "raw-blocks",
      "from": "sol_extract",
      "to": "validator",
      "label": "ordered blocks",
      "classification": "raw model output",
      "variant": "emphasis",
      "labelDy": 24
    },
    {
      "id": "sanitized-blocks",
      "from": "validator",
      "to": "processors",
      "label": "sanitized blocks",
      "classification": "validated blocks",
      "variant": "emphasis"
    },
    {
      "id": "refine-req",
      "from": "processors",
      "to": "sol_refine",
      "label": "refinement request",
      "classification": "optional",
      "variant": "dashed"
    },
    {
      "id": "doc-tree",
      "from": "processors",
      "to": "doc_model",
      "label": "document tree",
      "classification": "document tree",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": -24
    },
    {
      "id": "refined-tree",
      "from": "sol_refine",
      "to": "doc_model",
      "label": "refined blocks",
      "classification": "cleaned layout",
      "variant": "dashed"
    },
    {
      "id": "doc-model-out",
      "from": "doc_model",
      "to": "renderers",
      "label": "in-memory document",
      "classification": "document model",
      "variant": "default"
    },
    {
      "id": "rendered-output",
      "from": "renderers",
      "to": "gui_export",
      "label": "rendered formats",
      "classification": "exports",
      "variant": "default"
    },
    {
      "id": "extract-page-text",
      "from": "doc_model",
      "to": "page_text",
      "label": "normalized text",
      "classification": "page text",
      "variant": "default"
    },
    {
      "id": "chat-context",
      "from": "page_text",
      "to": "luna_draft",
      "label": "page context",
      "classification": "context",
      "variant": "default"
    },
    {
      "id": "draft-answer",
      "from": "luna_draft",
      "to": "quote_verify",
      "label": "draft quotes",
      "classification": "draft answer",
      "variant": "security",
      "labelAt": [960, 430]
    }
  ]
}
