{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "DocLayout Conversion Workflow",
    "animation": "trace",
    "quality_profile": "showcase",
    "viewBox": [1200, 720],
    "views": [
      {
        "id": "conversion-path",
        "label": "Document conversion",
        "focus": ["user_input", "page_prep", "sol_infer", "val_gate", "doc_builder", "renderers", "file_export"],
        "note": "Follow the primary pipeline from file ingest to local artifact export."
      },
      {
        "id": "validation-and-recovery",
        "label": "Validation and recovery",
        "focus": ["sol_infer", "val_gate", "val_retry"],
        "note": "See schema enforcement and the error recovery branch for malformed blocks."
      },
      {
        "id": "grounded-chat",
        "label": "Grounded chat",
        "focus": ["doc_builder", "luna_chat"],
        "note": "Document tree feeds independent Luna chat with citation quote checks."
      }
    ]
  },
  "lanes": [
    { "id": "client", "label": "User & Surfaces" },
    { "id": "pipeline", "label": "Document Engine" },
    { "id": "inference", "label": "Model Services" },
    { "id": "exception", "label": "Recovery Path", "variant": "exception" },
    { "id": "delivery", "label": "Export & Rendering" }
  ],
  "phases": [
    { "id": "intake", "label": "Intake & Preparation", "fromCol": 0, "toCol": 1 },
    { "id": "extraction", "label": "Vision & Validation", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "delivery_phase", "label": "Assembly & Output", "fromCol": 4, "toCol": 5 }
  ],
  "groups": [
    { "id": "inference_group", "label": "Sol extraction loop", "lane": "inference", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "delivery_group", "label": "Local outputs", "lane": "delivery", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": [
    "user_input",
    "page_prep",
    "sol_infer",
    "val_gate",
    "doc_builder",
    "renderers",
    "file_export"
  ],
  "nodes": [
    {
      "id": "user_input",
      "lane": "client",
      "col": 0,
      "type": "external",
      "label": "Doc Input",
      "sublabel": "PDF / office"
    },
    {
      "id": "page_prep",
      "lane": "pipeline",
      "col": 1,
      "type": "backend",
      "label": "Page Gate",
      "sublabel": "PDFium 192 DPI",
      "tag": "limit <= 3"
    },
    {
      "id": "sol_infer",
      "lane": "inference",
      "col": 2,
      "type": "cloud",
      "label": "GPT-6 Sol",
      "sublabel": "vision JSON",
      "tag": "structured"
    },
    {
      "id": "val_gate",
      "lane": "inference",
      "col": 3,
      "type": "security",
      "label": "Validator",
      "sublabel": "Pydantic schema",
      "tag": "bounds check"
    },
    {
      "id": "val_retry",
      "lane": "exception",
      "col": 3,
      "type": "security",
      "label": "Recovery",
      "sublabel": "repair or retry"
    },
    {
      "id": "doc_builder",
      "lane": "pipeline",
      "col": 4,
      "type": "backend",
      "label": "Doc Builder",
      "sublabel": "block hierarchy"
    },
    {
      "id": "renderers",
      "lane": "delivery",
      "col": 4,
      "type": "backend",
      "label": "Renderers",
      "sublabel": "MD, JSON, chunks"
    },
    {
      "id": "file_export",
      "lane": "delivery",
      "col": 5,
      "type": "frontend",
      "label": "Exports",
      "sublabel": "HTML, PDF, ZIP"
    },
    {
      "id": "luna_chat",
      "lane": "client",
      "col": 5,
      "type": "cloud",
      "label": "Luna Chat",
      "sublabel": "grounded quotes",
      "tag": "verified"
    }
  ],
  "edges": [
    {
      "id": "input-to-prep",
      "from": "user_input",
      "to": "page_prep",
      "variant": "emphasis"
    },
    {
      "id": "prep-to-sol",
      "from": "page_prep",
      "to": "sol_infer",
      "variant": "emphasis"
    },
    {
      "id": "sol-to-val",
      "from": "sol_infer",
      "to": "val_gate",
      "variant": "emphasis"
    },
    {
      "id": "val-to-builder",
      "from": "val_gate",
      "to": "doc_builder",
      "variant": "emphasis"
    },
    {
      "id": "val-to-retry",
      "from": "val_gate",
      "to": "val_retry",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "retry-to-sol",
      "from": "val_retry",
      "to": "sol_infer",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "builder-to-renderers",
      "from": "doc_builder",
      "to": "renderers",
      "variant": "emphasis"
    },
    {
      "id": "renderers-to-export",
      "from": "renderers",
      "to": "file_export",
      "variant": "emphasis"
    },
    {
      "id": "builder-to-luna",
      "from": "doc_builder",
      "to": "luna_chat",
      "role": "branch",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Ingestion & Rasterization",
      "items": [
        "PDFium rasterizes source pages at 192 DPI with lossless image extraction",
        "Page dispatcher enforces the concurrency limit of at most 3 in-flight calls"
      ]
    },
    {
      "dot": "cyan",
      "title": "Validation & Assembly",
      "items": [
        "Pydantic validation verifies block boundaries, text content, and hierarchy",
        "Failed blocks route to the recovery handler before document construction",
        "Document builder orchestrates reading order and block tree assembly"
      ]
    },
    {
      "dot": "violet",
      "title": "Zero-Cost Output",
      "items": [
        "Local renderers produce Markdown, hierarchical JSON, and styled HTML offline",
        "Independent Luna chat performs grounded citations with quote checks"
      ]
    }
  ]
}
