{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "DocLayout conversion lifecycle",
    "quality_profile": "showcase",
    "viewBox": [
      980,
      566
    ],
    "views": [
      {
        "id": "conversion",
        "label": "Conversion phases",
        "focus": [
          "queued",
          "rasterizing",
          "extracting",
          "validating",
          "ready"
        ],
        "note": "Prepare V3 before new conversion. Failed layout uses whole-page Sol; saved field retries skip both stages."
      },
      {
        "id": "failures",
        "label": "Document failures",
        "focus": [
          "extracting",
          "request_failed",
          "validating",
          "schema_failed"
        ],
        "note": "Sol request or schema failures stop this document. V3 failure records Sol fallback and continues."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Conversion phases"
    },
    {
      "id": "terminal",
      "label": "Document failures"
    }
  ],
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "Queued",
      "sublabel": "prepare V3 once",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "entry"
    },
    {
      "id": "rasterizing",
      "type": "active",
      "label": "Rasterizing",
      "sublabel": "PDFium 192 DPI",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "local"
    },
    {
      "id": "extracting",
      "type": "active",
      "label": "Extracting",
      "sublabel": "V3 then Sol",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "Sol if V3 fails"
    },
    {
      "id": "validating",
      "type": "decision",
      "label": "Validating",
      "sublabel": "Pydantic schema",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "check"
    },
    {
      "id": "ready",
      "type": "success",
      "label": "Ready",
      "sublabel": "matched + processed",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "done"
    },
    {
      "id": "request_failed",
      "type": "failure",
      "label": "Sol failed",
      "sublabel": "Refusal / API failure",
      "lane": "terminal",
      "col": 0,
      "yOffset": -75
    },
    {
      "id": "schema_failed",
      "type": "failure",
      "label": "Invalid output",
      "sublabel": "Schema / page checks",
      "lane": "terminal",
      "col": 1,
      "yOffset": -75
    }
  ],
  "transitions": [
    {
      "from": "extracting",
      "to": "request_failed",
      "variant": "security"
    },
    {
      "from": "validating",
      "to": "schema_failed",
      "variant": "security"
    }
  ]
}
