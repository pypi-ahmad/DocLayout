  "cards": [
    {
      "dot": "emerald",
      "title": "Ordered Conversion Rail",
      "items": [
        "Every document moves linearly from queued ingestion through rendering",
        "Sol extraction produces structured JSON blocks per page",
        "Document model reaches Ready when all pages are assembled and indexed"
      ]
    },
    {
      "dot": "amber",
      "title": "Transient Rate Limits",
      "items": [
        "Concurrent calls are strictly capped at 3 simultaneous requests",
        "Rate limiting introduces exponential backoff without dropping the run",
        "Wait states preserve document state in memory until slots free up"
      ]
    },
    {
      "dot": "rose",
      "title": "Resilience & Termination",
      "items": [
        "Malformed outputs trigger automatic repair and re-prompting",
        "Fatal file corruption or exhausted retries route to terminal exits",
        "Terminal exits do not re-enter active execution loops"
      ]
    }
