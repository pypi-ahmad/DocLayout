{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "DocLayout processing lifecycle",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      570
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Conversion phases"
    },
    {
      "id": "fallback",
      "label": "Recoverable V3 failure"
    }
  ],
  "states": [
    {
      "id": "accepted-input",
      "type": "start",
      "label": "Accepted",
      "sublabel": "Validate options",
      "lane": "main",
      "col": 0
    },
    {
      "id": "layout-attempt",
      "type": "active",
      "label": "Prepare/render",
      "sublabel": "Try V3 locally",
      "lane": "main",
      "col": 1
    },
    {
      "id": "sol-active",
      "type": "active",
      "label": "Transcribe",
      "sublabel": "Sol full image",
      "lane": "main",
      "col": 2
    },
    {
      "id": "protected-tree",
      "type": "active",
      "label": "Align/process",
      "sublabel": "Retain Sol content",
      "lane": "main",
      "col": 3
    },
    {
      "id": "complete-output",
      "type": "success",
      "label": "Complete",
      "sublabel": "Local exports",
      "lane": "main",
      "col": 4
    },
    {
      "id": "layout-unavailable",
      "type": "failure",
      "label": "V3 unavailable",
      "sublabel": "Keep Sol boxes",
      "lane": "fallback",
      "col": 0
    },
    {
      "id": "conversion-failed",
      "type": "failure",
      "label": "Conversion failed",
      "sublabel": "No final result",
      "lane": "fallback",
      "col": 2
    }
  ],
  "transitions": [
    {
      "from": "layout-attempt",
      "to": "layout-unavailable",
      "label": "runtime error"
    },
    {
      "from": "layout-unavailable",
      "to": "sol-active",
      "label": "image only"
    },
    {
      "from": "protected-tree",
      "to": "conversion-failed",
      "label": "invariant",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Failure handling",
      "items": [
        "V3 runtime errors use Sol boxes; invalid configuration, Sol extraction, guide limits, or invariants are fatal.",
        "Auto may use CPU after CUDA failure; explicit CUDA does not fall back."
      ]
    }
  ]
}
