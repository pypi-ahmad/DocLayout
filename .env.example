# Copy to .env in the folder where you launch DocLayout, then edit locally.
# Environment variables take precedence over this file, including empty values.
OPENAI_API_KEY=your-api-key
# Optional: uncomment only for a custom compatible endpoint.
# OPENAI_BASE_URL=https://your-endpoint.example/v1

# Required only for the HTTP API: generate a separate random token (32+ ASCII characters).
# DOCLAYOUT_API_TOKEN=
# Optional dedicated existing directory; filepath API access is disabled when unset.
# DOCLAYOUT_INPUT_ROOT=D:\documents\api-input

# Local layout settings are NOT read from this .env file.
# Set them in the launching process, or copy/uncomment them in local.env instead.
# auto verifies CUDA execution, then tries CPU; cuda never substitutes a CPU session.
# If V3 remains unavailable, conversion uses Sol with explicit fallback metadata.
# DOCLAYOUT_LAYOUT_DEVICE=auto
# Default cache: <BASE_DIR>/cache/pp-doclayoutv3. Override with a writable directory.
# DOCLAYOUT_LAYOUT_CACHE_DIR=D:\HCSC\DocLayout\cache\pp-doclayoutv3
# Optional exact directory containing the pinned inference.onnx and inference.yml:
# DOCLAYOUT_LAYOUT_MODEL_DIR=D:\HCSC\DocLayout\cache\layout-model
# DOCLAYOUT_LAYOUT_OFFLINE=false
