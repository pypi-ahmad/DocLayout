# Copy to .env in the folder where you launch DocLayout, then edit locally.
# Environment variables take precedence over this file, including empty values.
OPENAI_API_KEY=your-api-key
# Optional: uncomment only for a custom compatible endpoint.
# OPENAI_BASE_URL=https://your-endpoint.example/v1

# Required only for the HTTP API: generate a separate random token (32+ ASCII characters).
# DOCLAYOUT_API_TOKEN=
# Optional dedicated existing directory; filepath API access is disabled when unset.
# DOCLAYOUT_INPUT_ROOT=D:\documents\api-input

# Layout settings use process environment variables or local.env, NOT this .env.
# Set before launching DocLayout; see docs/configuration.md#mandatory-layout-policy.
# DOCLAYOUT_LAYOUT_DEVICE=auto
# cpu is explicit CPU; cuda never falls back to CPU. V3 failures use Sol.
# DOCLAYOUT_LAYOUT_CACHE_DIR=D:\AI\DocLayout\.cache\layout
# Optional DOCLAYOUT_ALIGNMENT_POLICY enables matching; if set, supply all five evaluated
# values: min_iou, min_score, min_containment, min_area_ratio, max_center_distance.
# No production threshold defaults are supplied. Keep model weights outside Git.
# When absent, retain Sol boxes/order; V3 provides guidance when available.
# First conversion downloads absent pinned weights; auto may fall back to CPU.
# If V3 cannot prepare or infer, conversion warns and uses Sol on the full image.
# Invalid configuration, guide limits, and downstream layout violations remain errors.
